# Copy to .env and fill in what you use. Never commit .env.
# Only keys for providers you actually use are needed; `task-agent models` shows what resolved.

# --- Model providers (planner / worker / router / judge chains in config/models.yaml) ---
OLLAMA_API_KEY=            # Ollama Cloud
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Local Ollama for the worker role (docker compose --profile local-models, or your own install)
OLLAMA_BASE_URL=http://localhost:11434
# WORKER_LOCAL_MODEL=qwen3:14b

# --- Tracing: the dev compose stack provisions these keys on first start ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
# TASK_AGENT_TRACING=auto          # auto | langfuse | otlp | console | off
# TASK_AGENT_TRACE_CONTENT=true    # set false to keep prompts/outputs out of traces

# --- App ---
# TASK_AGENT_MODELS_CONFIG=config/models.yaml   # config/models.mock.yaml runs offline
# TASK_AGENT_LOG_LEVEL=INFO
# TASK_AGENT_LOG_FORMAT=console    # json in containers

# --- Dev stack passwords (local only; change for anything reachable from a network) ---
# POSTGRES_PASSWORD=taskagent
# REDIS_PASSWORD=taskagent
# CLICKHOUSE_PASSWORD=clickhouse
# MINIO_ROOT_PASSWORD=miniosecret
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=   # 64 hex chars: openssl rand -hex 32
# LANGFUSE_NEXTAUTH_SECRET=
