# Copy to .env and fill in what you use. Never commit .env.
# Everything below has a free tier. `task-agent models` and `task-agent tools` show what loaded.

# --- Models: one key is enough to start; more keys = more free quota via fallback ----------
# Planner chain (all serve gpt-oss-120b, then Gemini as last resort): see config/models.yaml
CEREBRAS_API_KEY=          # https://cloud.cerebras.ai     (free, generous tokens/day)
GROQ_API_KEY=              # https://console.groq.com      (free, low tokens/minute)
OPENROUTER_API_KEY=        # https://openrouter.ai/keys    (free models, ~50 req/day)
OLLAMA_API_KEY=            # https://ollama.com/settings/keys (free cloud tier)
GEMINI_API_KEY=            # https://aistudio.google.com/apikey (free tier)
# Local Ollama for the worker role, only if you have a GPU machine running it:
# OLLAMA_BASE_URL=http://localhost:11434

# --- Tools --------------------------------------------------------------------------------
TAVILY_API_KEY=            # web_search  https://app.tavily.com (1,000 searches/month free)
E2B_API_KEY=               # run_python  https://e2b.dev (Hobby: $100 one-time credit)
COMPOSIO_API_KEY=          # Gmail etc.  https://composio.dev, then: task-agent connect gmail
# FIRECRAWL_API_KEY=       # read_url upgrade for JS-heavy pages (Jina Reader is used otherwise)
# JINA_API_KEY=            # optional: higher Jina Reader rate limit
# TASK_AGENT_COMPOSIO_USER_ID=default
# TASK_AGENT_SANDBOX_INTERNET=false   # let sandbox code reach the internet (pip install etc.)

# --- GAIA benchmark (optional): accept the terms on Hugging Face first ---------------------
# HF_TOKEN=

# --- Tracing: the dev compose stack provisions these keys on first start -------------------
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
# TASK_AGENT_TRACING=auto          # auto | langfuse | otlp | console | off
# TASK_AGENT_TRACE_CONTENT=true    # set false to keep prompts/outputs out of traces

# --- App -----------------------------------------------------------------------------------
# TASK_AGENT_MODELS_CONFIG=config/models.yaml   # config/models.mock.yaml runs offline
# TASK_AGENT_POLICY_FILE=policies/default.yaml
# TASK_AGENT_LOG_LEVEL=INFO
# TASK_AGENT_LOG_FORMAT=console    # json in containers

# --- Dev stack passwords (local only; change for anything reachable from a network) --------
# POSTGRES_PASSWORD=taskagent
# REDIS_PASSWORD=taskagent
# CLICKHOUSE_PASSWORD=clickhouse
# MINIO_ROOT_PASSWORD=miniosecret
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=   # 64 hex chars: openssl rand -hex 32
# LANGFUSE_NEXTAUTH_SECRET=
